# Copy to .env. Do not commit .env.
ADMIN_TOKEN=replace-with-a-long-random-token
PUBLIC_PORT=8787
ADMIN_PORT=8788
DATA_DIR=./data
BUNDLE_PATH=contracts/bundle.json

# Loopback admin API for internal.run --live.
INTAKE_ADMIN_URL=http://127.0.0.1:8788

# Optional OpenAI-compatible endpoint. Polishes brd.md wording only.
# If these are unset, or the call fails, the rules text is kept.
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_MODEL=
INTERNAL_LLM_API_KEY=
