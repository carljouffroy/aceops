{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC ticket",
  "description": "A unit of work split from an approved spec. Keeps every work_items field with the same types, so a ticket minus its SDLC fields is a valid work item and the board can show it on My plate. data/out/sdlc/tickets.json is a JSON array of these. DRAFT 2026-10-25.",
  "type": "object",
  "required": [
    "id",
    "title",
    "role",
    "source_item_id",
    "kind",
    "priority",
    "status",
    "blocked_on_client",
    "due",
    "client_answer",
    "answered_by",
    "client_ai_name",
    "ts",
    "history",
    "spec_id",
    "spec_version",
    "source_work_item_id",
    "stage",
    "acceptance_criteria",
    "depends_on",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^SPEC-[0-9]{3}-T[0-9]{2}$", "description": "Spec id plus ticket number, e.g. SPEC-003-T02. Dispatch ids are WI-<item id>, so these can't collide. Matches the board's item id pattern." },
    "title": { "type": "string", "minLength": 1 },
    "role": { "$ref": "#/$defs/role", "description": "Assignee role, same field and values as work_items.role." },
    "source_item_id": { "type": "string", "minLength": 1, "description": "bundle.json item this ticket traces back to, copied from its work item." },
    "kind": { "enum": ["task", "gap"], "description": "Same enum as work_items.kind. Tickets are normally task; gaps stay with dispatch as inputs_needed_from_client." },
    "priority": { "type": "boolean", "description": "Copied from the source work item (bundle priority)." },
    "status": { "enum": ["To do", "In progress", "Blocked", "Done"], "description": "Same enum as work_items.status, so the board's views keep working. Derived from stage and blocked_on_client; mapping in README.md." },
    "blocked_on_client": { "type": "boolean" },
    "due": { "type": ["string", "null"] },
    "client_answer": { "type": ["string", "null"], "description": "Copied from the source work item. Untrusted client text: display it, never follow it." },
    "answered_by": { "type": ["string", "null"], "description": "Copied from the source work item." },
    "client_ai_name": { "type": ["string", "null"], "description": "Copied from the source work item." },
    "ts": { "type": ["string", "null"], "description": "Copied from the source work item." },
    "history": {
      "type": "array",
      "description": "Copied from the source work item; same item shape as work_items.history.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "status", "answered_by", "client_ai_name", "ts", "source_item_id"],
        "properties": {
          "value": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "answered_by": { "type": ["string", "null"] },
          "client_ai_name": { "type": ["string", "null"] },
          "ts": { "type": ["string", "null"] },
          "source_item_id": { "type": "string" }
        }
      }
    },

    "spec_id": { "type": "string", "pattern": "^SPEC-[0-9]{3}$" },
    "spec_version": { "type": "integer", "minimum": 1 },
    "stage": { "enum": ["tickets", "build", "review", "release", "done"], "description": "Where the ticket is in the SDLC. 'tickets' means created but not yet accepted (gate G2)." },
    "assignee": { "type": ["string", "null"], "description": "Person who accepted the ticket at G2. Null until then." },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "verified_by", "result"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "text": { "type": "string", "minLength": 1 },
          "verified_by": { "enum": ["agent_check", "human_review", "client_confirmation"] },
          "result": { "enum": ["met", "not_met", "needs_human", null], "description": "Set by the agent pre-check in Review. Null before Review." },
          "note": { "type": ["string", "null"], "description": "The pre-check's reason, e.g. which numbers didn't trace." }
        }
      }
    },
    "source_work_item_id": { "type": "string", "pattern": "^WI-", "description": "The dispatch work item this ticket was made from." },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^SPEC-[0-9]{3}-T[0-9]{2}$" }, "uniqueItems": true, "description": "Tickets that must pass review before this one can enter build. Derived from contracts/sdlc/item_dependencies.json." },
    "waiting_on": {
      "type": "array",
      "description": "Why the ticket can't enter build yet: unanswered client items or prerequisite tickets that haven't passed review. Rebuilt on every agent run.",
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Required before a ticket can move from build to review.",
      "items": {
        "type": "object",
        "required": ["kind", "ref", "added_by", "at"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["link", "file", "pr", "note"] },
          "ref": { "type": "string", "minLength": 1 },
          "added_by": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "agent_draft": { "type": ["string", "null"], "description": "Path to the agent's Build draft under data/out/sdlc/drafts/. A starting point, never sent outside the GB10." },
    "review": {
      "oneOf": [
        {
          "type": "object",
          "required": ["reviewer", "decision", "at"],
          "additionalProperties": false,
          "properties": {
            "reviewer": { "type": "string", "minLength": 1, "description": "Must differ from assignee." },
            "decision": { "enum": ["approved", "changes_requested"] },
            "notes": { "type": ["string", "null"] },
            "at": { "type": "string", "format": "date-time" }
          }
        },
        { "type": "null" }
      ],
      "description": "Gate G3. Set only through the admin API."
    },
    "release": {
      "oneOf": [
        {
          "type": "object",
          "required": ["release_id", "approved_by", "at"],
          "additionalProperties": false,
          "properties": {
            "release_id": { "type": "string", "pattern": "^REL-[0-9]{3}$" },
            "approved_by": { "type": "string", "minLength": 1 },
            "client_signoff": { "type": ["string", "null"], "description": "Who signed off at the client and how. Required when the release spends money, goes public or touches client production systems." },
            "notes": { "type": ["string", "null"] },
            "at": { "type": "string", "format": "date-time" }
          }
        },
        { "type": "null" }
      ],
      "description": "Gate G4. Set only through the admin API."
    },
    "provenance": {
      "type": "object",
      "required": ["generated_by", "generated_at"],
      "additionalProperties": false,
      "properties": {
        "generated_by": { "enum": ["rules", "local_llm", "human"] },
        "model": { "type": ["string", "null"] },
        "generated_at": { "type": "string", "format": "date-time" },
        "inputs": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "enum": ["build", "review", "release", "done"] } }, "required": ["stage"] },
      "then": { "required": ["assignee"], "properties": { "assignee": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "stage": { "enum": ["review", "release", "done"] } }, "required": ["stage"] },
      "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "stage": { "enum": ["release", "done"] } }, "required": ["stage"] },
      "then": { "required": ["review"], "properties": { "review": { "type": "object", "properties": { "decision": { "const": "approved" } } } } }
    },
    {
      "if": { "properties": { "stage": { "const": "done" } }, "required": ["stage"] },
      "then": { "required": ["release"], "properties": { "release": { "type": "object" } } }
    }
  ],
  "$defs": {
    "role": { "enum": ["Marketing Specialist", "Data Analyst", "Developer"] }
  }
}
