# GB10 values for aceops/.env (local inference only). Used by docs/sdlc/gb10-runbook.md, section 3.
# Copy to .env, then set ADMIN_TOKEN. Never commit .env.
#
# Format is the repo's own dotenv (scripts/run_demo.sh, src/intake/config.py, src/sdlc/config.py):
# KEY=value, one per line, no spaces around "=", no inline comments, no quotes needed.
# scripts/run_demo.sh exports every key in this file and overrides the same variable in your shell,
# so put model settings HERE, not in `export`. (DEMO_MODE is not in this file on purpose, so
# `DEMO_MODE=scripted make demo` still works.)

ADMIN_TOKEN=replace-with-output-of-openssl-rand-hex-32
PUBLIC_PORT=8787
ADMIN_PORT=8788
DATA_DIR=./data
BUNDLE_PATH=contracts/bundle.json
INTAKE_ADMIN_URL=http://127.0.0.1:8788

# Client agent (src/intake/client_agent.py): Ollama's OpenAI-compatible API on host loopback.
# As of 14:17 PT the GB10 has ONE model installed: nemotron-3-nano:30b (Ollama 0.40.11, tool calling
# verified, warm call about 1.6 s). The client agent sends max_tokens 200 with a 20 s timeout and
# needs bare JSON back; a reasoning model can spend that budget thinking. Run the smoke test in
# runbook section 3.3. If it fails, `ollama pull llama3.1:8b` and set LLM_MODEL=llama3.1:8b.
# Use exact `ollama list` tags.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=nemotron-3-nano:30b
LLM_API_KEY=

# Internal agent (BRD wording polish) and the SDLC service (falls back to these when SDLC_LLM_* is unset).
# Loopback only: src/sdlc/config.py refuses to start on a non-loopback URL. 20 s timeout; on failure
# the rules text is kept.
INTERNAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
INTERNAL_LLM_MODEL=nemotron-3-nano:30b
INTERNAL_LLM_API_KEY=

SDLC_MCP_PORT=8791
SDLC_CONSOLE_PORT=8792
